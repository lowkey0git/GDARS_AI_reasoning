# ============================================================
# GDARS v2 — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ── LLM (Groq — all free tier) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Optional: override default model assignments
# GROQ_ROUTER_MODEL=llama3-8b-8192
# GROQ_REASONING_MODEL=llama-3.3-70b-versatile
# GROQ_SYNTHESIS_MODEL=llama-3.1-8b-instant
# GROQ_CODE_MODEL=llama-3.3-70b-versatile

# ── Web retrieval (Tavily — free tier available) ──────────────
RETRIEVAL_TAVILY_API_KEY=your_tavily_api_key_here

# ── Memory ───────────────────────────────────────────────────
MEMORY_REDIS_URL=redis://localhost:6379/0
MEMORY_CHROMA_PERSIST_DIR=./data/chroma
MEMORY_FAISS_INDEX_PATH=./data/faiss_index
MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_WORKING_MEMORY_TTL_SECONDS=3600

# ── Planner ──────────────────────────────────────────────────
PLANNER_MAX_ITERATIONS=8
PLANNER_CONFIDENCE_THRESHOLD=0.78
PLANNER_REFLECTION_THRESHOLD=0.60
PLANNER_COMPLEXITY_CONFIDENCE_CUTOFF=0.70

# ── Evaluation ───────────────────────────────────────────────
EVAL_MIN_FACTUALITY_SCORE=0.55
EVAL_MIN_USEFULNESS_SCORE=0.50
EVAL_SCORE_INTERMEDIATE_STEPS=true

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=INFO
API_LOG_FILE=./logs/gdars.log

# ── System ───────────────────────────────────────────────────
ENVIRONMENT=development
